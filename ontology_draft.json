{
  "metadata": {
    "version": "1.0-draft",
    "source_schema": "siemens_schema.yaml",
    "domain": "Industrial Manufacturing",
    "client": "Siemens",
    "annotation_instructions": "Search 'AUTO_PROPOSED' to find all edges needing review. Edit 'relationship' verb and 'description' as needed. Set 'annotation_status' to 'REVIEWED' when confirmed. Do not remove 'annotation_note' \u2014 keep for audit trail."
  },
  "nodes": [
    {
      "id": "operations.machines",
      "label": "Machine",
      "table": "machines",
      "schema": "operations",
      "description": "Physical manufacturing asset deployed on the factory floor (CNC mills, robotic arms, welding units, etc.)",
      "key_attributes": [
        "machine_id",
        "plant_id",
        "machine_type",
        "model",
        "status",
        "location_zone"
      ]
    },
    {
      "id": "operations.maintenance_logs",
      "label": "MaintenanceEvent",
      "table": "maintenance_logs",
      "schema": "operations",
      "description": "Record of a maintenance intervention performed on a machine, including issue type, downtime, and repair cost",
      "key_attributes": [
        "log_id",
        "machine_id",
        "issue_type",
        "resolved",
        "priority"
      ]
    },
    {
      "id": "operations.parts_inventory",
      "label": "Part",
      "table": "parts_inventory",
      "schema": "operations",
      "description": "Spare part or component stocked in a warehouse and compatible with one or more machines",
      "key_attributes": [
        "part_id",
        "supplier_id",
        "machine_id",
        "part_name",
        "warehouse_location"
      ]
    },
    {
      "id": "quality.production_batches",
      "label": "ProductionBatch",
      "table": "production_batches",
      "schema": "quality",
      "description": "A discrete production run executed by a machine, tracking units produced, defect rate, and shift",
      "key_attributes": [
        "batch_id",
        "machine_id",
        "plant_id",
        "product_line",
        "shift",
        "batch_status"
      ]
    },
    {
      "id": "quality.defect_reports",
      "label": "DefectReport",
      "table": "defect_reports",
      "schema": "quality",
      "description": "Quality defect identified during or after a production batch, linked to a specific part and root cause",
      "key_attributes": [
        "defect_id",
        "batch_id",
        "part_id",
        "defect_type",
        "severity",
        "detection_method",
        "rework_required",
        "root_cause"
      ]
    }
  ],
  "edges": [
    {
      "from_table": "operations.maintenance_logs",
      "to_table": "operations.machines",
      "from_label": "MaintenanceEvent",
      "to_label": "Machine",
      "join_key": "machine_id",
      "relationship": "LOGGED_FOR",
      "description": "A maintenance event is recorded against the machine it was performed on",
      "cardinality": "many_to_one",
      "cross_db": false,
      "include_as_attribute": true,
      "annotation_status": "AUTO_PROPOSED",
      "annotation_note": "Annotator: confirm verb. Alternatives: PERFORMED_ON, TRIGGERED_BY, RECORDED_FOR"
    },
    {
      "from_table": "operations.parts_inventory",
      "to_table": "operations.machines",
      "from_label": "Part",
      "to_label": "Machine",
      "join_key": "machine_id",
      "relationship": "COMPATIBLE_WITH",
      "description": "A part is stocked as compatible with or designated for a specific machine",
      "cardinality": "many_to_one",
      "cross_db": false,
      "include_as_attribute": true,
      "annotation_status": "AUTO_PROPOSED",
      "annotation_note": "Annotator: confirm verb. Alternatives: USED_IN, DESIGNATED_FOR, SERVICED_BY"
    },
    {
      "from_table": "quality.production_batches",
      "to_table": "operations.machines",
      "from_label": "ProductionBatch",
      "to_label": "Machine",
      "join_key": "machine_id",
      "relationship": "PRODUCED_BY",
      "description": "A production batch is executed by a specific machine on the factory floor",
      "cardinality": "many_to_one",
      "cross_db": true,
      "include_as_attribute": true,
      "annotation_status": "AUTO_PROPOSED",
      "annotation_note": "Annotator: confirm verb. Alternatives: EXECUTED_BY, RUN_ON, ASSIGNED_TO"
    },
    {
      "from_table": "quality.production_batches",
      "to_table": "operations.machines",
      "from_label": "ProductionBatch",
      "to_label": "Machine",
      "join_key": "plant_id",
      "relationship": "OCCURS_AT",
      "description": "A production batch occurs at the same plant as the machine \u2014 plant_id is also retained as a shared attribute on both nodes",
      "cardinality": "many_to_one",
      "cross_db": true,
      "include_as_attribute": true,
      "annotation_status": "AUTO_PROPOSED",
      "annotation_note": "Annotator: plant_id is a shared attribute on both Machine and ProductionBatch. This edge captures the co-location relationship. Alternatives: LOCATED_AT, BELONGS_TO_PLANT. Can be removed if deemed redundant."
    },
    {
      "from_table": "quality.defect_reports",
      "to_table": "quality.production_batches",
      "from_label": "DefectReport",
      "to_label": "ProductionBatch",
      "join_key": "batch_id",
      "relationship": "BELONGS_TO",
      "description": "A defect report is raised against the production batch in which the defect was detected",
      "cardinality": "many_to_one",
      "cross_db": false,
      "include_as_attribute": true,
      "annotation_status": "AUTO_PROPOSED",
      "annotation_note": "Annotator: confirm verb. Alternatives: DETECTED_IN, RAISED_FOR, PART_OF"
    },
    {
      "from_table": "quality.defect_reports",
      "to_table": "operations.parts_inventory",
      "from_label": "DefectReport",
      "to_label": "Part",
      "join_key": "part_id",
      "relationship": "CAUSED_BY",
      "description": "A defect is attributed to a specific part that failed or was out of specification",
      "cardinality": "many_to_one",
      "cross_db": true,
      "include_as_attribute": true,
      "annotation_status": "AUTO_PROPOSED",
      "annotation_note": "Annotator: confirm verb. Note directionality \u2014 defect report points TO the part. Alternatives: LINKED_TO_PART, INVOLVES, ORIGINATED_FROM"
    }
  ],
